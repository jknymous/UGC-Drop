# Discord Bot
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here
DISCORD_GUILD_ID=your_server_id_here

# Channel IDs (klik kanan channel di Discord > Copy Channel ID, aktifkan Developer Mode dulu di Settings > Advanced)
LIVE_CHANNEL_ID=channel_id_untuk_ugc_yang_masih_available
SOLDOUT_CHANNEL_ID=channel_id_untuk_ugc_yang_udah_habis

# Polling interval dalam menit (default 5 menit, jangan terlalu kecil biar ga kena rate limit)
POLL_INTERVAL_MINUTES=5

# Roblox Catalog search config
# Category 11 = Accessories (paling sering dipake buat free UGC), bisa ditambah kategori lain nanti
CATALOG_CATEGORY=11
CATALOG_SUBCATEGORY=

# Role ID yang boleh pake command admin (misal /addmapinfo, /forcecheck)
ADMIN_ROLE_ID=role_id_admin_disini
